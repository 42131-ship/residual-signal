; 残余信号 · Godot 工程
; 规格见 design/PIXEL_SPEC.md：原生 384×216（×5 = 1920×1080），最近邻，整数倍缩放
; 玩家实际看到的是 1920×1080：窗口客户区 1920×1080，viewpoint 384×216 按整数 5× 放大。
config_version=5

[application]

config/name="残余信号 Residual Signal"
config/version="0.1.0"
; 应用图标唯一真源：tools/icon_build.py 生成（32×32 手排 ×8 = 256）
config/icon="res://art/generated_candidates/ui/icon_256.png"
run/main_scene="res://game/scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

TapDB="*res://game/runtime/tapdb_service.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
; 手机：横屏（4 = SENSOR_LANDSCAPE，左右都能转）。见 design/MOBILE.md
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0117, 0.0196, 0.0392, 1)
; 手机必须开 ETC2/ASTC，否则未压缩贴图会把低端机的显存吃爆
textures/vram_compression/import_etc2_astc=true

[input_devices]

; 触摸不要仿真成鼠标左键：否则点「蹲/手电筒」也会被走廊当成攻击（真机实测：按蹲，感染体倒下）。
pointing/emulate_mouse_from_touch=false
